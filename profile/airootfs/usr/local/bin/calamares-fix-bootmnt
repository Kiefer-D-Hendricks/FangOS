#!/bin/bash
# Restores /run/archiso/bootmnt if a copytoram boot removed it.
# Runs on the live system (dontChroot) before unpackfs. Harmless no-op on normal boots.
# NOTE: all ISO boot entries now pass copytoram=n, so this is purely a safety net
# for users who manually add copytoram=y at the boot menu.
set -u
TARGET="/run/archiso/bootmnt/arch/x86_64/airootfs.sfs"
LOG="/tmp/calamares-fix-bootmnt.log"
log() { echo "[$(date +%T)] $*" | tee -a "$LOG"; }

if [ -f "$TARGET" ]; then
    log "OK: $TARGET present, nothing to do."
    exit 0
fi
log "WARN: $TARGET missing, attempting restore..."
mkdir -p /run/archiso/bootmnt
if ! mountpoint -q /run/archiso/bootmnt 2>/dev/null; then
    uuid=$(grep -o "archisosearchuuid=[^ ]*" /proc/cmdline 2>/dev/null | cut -d= -f2 || true)
    if [ -n "$uuid" ]; then
        log "Trying mount by UUID $uuid ..."
        mount -U "$uuid" /run/archiso/bootmnt 2>>"$LOG" || \
        mount "/dev/disk/by-uuid/$uuid" /run/archiso/bootmnt 2>>"$LOG" || \
        log "WARN: UUID mount failed."
    else
        log "WARN: no archisosearchuuid on kernel cmdline."
    fi
fi
if [ -f "$TARGET" ]; then
    log "OK: restored via device mount."
    exit 0
fi
# Last resort: copytoram copied the image to RAM; link it into the expected layout.
if [ -f /run/archiso/copytoram/airootfs.sfs ]; then
    log "Linking /run/archiso/copytoram/airootfs.sfs into place..."
    mkdir -p /run/archiso/bootmnt/arch/x86_64
    ln -sf /run/archiso/copytoram/airootfs.sfs "$TARGET"
fi
if [ -f "$TARGET" ]; then
    log "OK: restored via copytoram link."
    exit 0
fi
log "ERROR: could not restore $TARGET. The install media may be unreadable;"
log "ERROR: try re-writing the USB stick."
exit 1
