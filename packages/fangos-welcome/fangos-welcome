#!/usr/bin/env python3
"""
fangos-welcome -- first-boot welcome app for FangOS.

Shows a short guided tour on first graphical login:
  1. What FangOS is
  2. How to use the `fang` package tool
  3. Where to find the website, source code, and community

The "Don't show this again" checkbox shadows the system autostart entry
with ~/.config/autostart/fangos-welcome.desktop containing Hidden=true,
which is the XDG-compliant per-user way to opt out of autostart.
"""

import os
import sys

from PyQt6.QtCore import Qt, QUrl
from PyQt6.QtGui import QDesktopServices
from PyQt6.QtWidgets import (
    QApplication,
    QCheckBox,
    QHBoxLayout,
    QLabel,
    QPlainTextEdit,
    QPushButton,
    QStackedWidget,
    QVBoxLayout,
    QWidget,
)

