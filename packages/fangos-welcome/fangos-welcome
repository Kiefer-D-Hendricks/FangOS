# -- Autostart handling -----------------------------------------------------
def _user_autostart_path():
    return os.path.join(os.path.expanduser("~/.config/autostart"), AUTOSTART_NAME)


def autostart_disabled():
    """True if the user opted out via a Hidden=true shadow entry."""
    path = _user_autostart_path()
    if not os.path.exists(path):
        return False
    try:
        with open(path, "r", encoding="utf-8") as f:
            return any(line.strip() == "Hidden=true" for line in f)
    except OSError:
        return False


def set_autostart_disabled(disabled):
    """Opt out of (or back into) the autostart entry, per-user."""
    path = _user_autostart_path()
    if disabled:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write("[Desktop Entry]\n")
            f.write("Type=Application\n")
            f.write("Name=FangOS Welcome\n")
            f.write("Hidden=true\n")
    else:
        try:
            os.remove(path)
        except FileNotFoundError:
            pass


# -- System detection -------------------------------------------------------
def _cpu_model():
    try:
        with open("/proc/cpuinfo", "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith("model name"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return platform.processor() or "Unknown"


def _ram_total():
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemTotal"):
                    kb = int(line.split()[1])
                    gb = kb / 1024 / 1024
                    return f"{gb:.1f} GB"
    except (OSError, ValueError, IndexError):
        pass
    return "Unknown"


def _gpu_model():
    # Try lspci first.
    try:
        out = subprocess.run(
            ["lspci"], capture_output=True, text=True, timeout=5
        ).stdout
        vga = [l for l in out.splitlines()
               if "VGA" in l or "3D controller" in l or "Display controller" in l]
        if vga:
            # Strip the "00:02.0 VGA compatible controller: " prefix.
            m = re.search(r"(?:VGA|3D|Display)[^:]*:\s*(.+)", vga[0])
            return m.group(1).strip() if m else vga[0].strip()
    except (OSError, subprocess.SubprocessError):
        pass
    # Fall back to /sys DRM devices.
    try:
        for card in sorted(os.listdir("/sys/class/drm")):
            if card.startswith("card") and "-" not in card:
                vendor = device = ""
                try:
                    with open(f"/sys/class/drm/{card}/device/vendor") as f:
                        vendor = f.read().strip()
                    with open(f"/sys/class/drm/{card}/device/device") as f:
                        device = f.read().strip()
                except OSError:
                    continue
                if vendor or device:
                    return f"PCI {vendor}:{device}"
    except OSError:
        pass
    return "Unknown"


def _kernel_version():
    return platform.release()


def _disk_space():
    try:
        usage = shutil.disk_usage("/")
        total = usage.total / 1024**3
        free = usage.free / 1024**3
        return f"{free:.1f} GB free of {total:.1f} GB"
    except OSError:
        return "Unknown"


def _desktop_env():
    return os.environ.get("XDG_CURRENT_DESKTOP", "Unknown")


# -- Action helpers ---------------------------------------------------------
def _run_in_terminal(command):
    """Run a shell command in the user's terminal emulator, detached."""
    from PyQt6.QtCore import QProcess

    wrapped = (
        f"{command}; echo; echo '--- done ---'; "
        "echo 'Press Enter to close...'; read"
    )
    for term, args in (
        ("konsole", ["-e", "bash", "-c", wrapped]),
        ("xdg-terminal-exec", ["bash", "-c", wrapped]),
        ("gnome-terminal", ["--", "bash", "-c", wrapped]),
        ("xterm", ["-e", "bash", "-c", wrapped]),
    ):
        if shutil.which(term):
            QProcess.startDetached(term, args)
            return True
    return False


def _open_settings():
    from PyQt6.QtCore import QProcess

    for app in ("systemsettings", "systemsettings5"):
        if shutil.which(app):
            QProcess.startDetached(app, [])
            return True
    return False


