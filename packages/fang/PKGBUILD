pkgname=fang
pkgver=0.3.0
pkgrel=1
pkgdesc="Friendly pacman frontend for FangOS"
arch=("any")
url="https://os.fangnet.me"
license=("GPL-3.0-or-later")
depends=("python" "pacman")

source=("fang" "fang-completion.bash")
sha256sums=("SKIP" "SKIP")

package() {
    install -Dm755 "$srcdir/fang" "$pkgdir/usr/bin/fang"
    install -Dm644 "$srcdir/fang-completion.bash" \
        "$pkgdir/usr/share/bash-completion/completions/fang"
}
